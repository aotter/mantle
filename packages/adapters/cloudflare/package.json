{
  "name": "@aotter/mantle-cloudflare",
  "version": "0.1.0-alpha.16",
  "description": "Cloudflare Workers adapter for Mantle runtime, Admin, MCP, and public Web mounts.",
  "license": "Apache-2.0",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle.git",
    "directory": "packages/adapters/cloudflare"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist .tsbuildinfo",
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "test": "pnpm test:facade-types && vitest run",
    "test:facade-types": "tsc --ignoreConfig --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --types @cloudflare/workers-types,node test/createMantleWorker.typecheck.ts",
    "bench:http-dispatch": "vitest bench --run test/http-dispatch.bench.ts",
    "bench:wrangler": "pnpm --filter @aotter/mantle-spec build && pnpm --filter @aotter/mantle-runtime build && node ../../../scripts/run-wrangler-performance.mjs"
  },
  "dependencies": {
    "@aotter/mantle-admin": "workspace:*",
    "@aotter/mantle-runtime": "workspace:*",
    "@aotter/mantle-spec": "workspace:*",
    "@aotter/mantle-web": "workspace:*",
    "@better-auth/cimd": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:"
  },
  "peerDependencies": {
    "aws4fetch": "catalog:peer",
    "better-auth": "catalog:peer",
    "hono": "catalog:peer",
    "zod": "catalog:peer"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@types/node": "catalog:",
    "aws4fetch": "catalog:",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.124.0",
    "zod": "catalog:"
  }
}
