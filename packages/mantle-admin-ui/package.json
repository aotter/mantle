{
  "name": "@aotter/mantle-admin-ui",
  "version": "0.1.2-alpha.4",
  "description": "Admin SPA for mantle — React 19 + Vite + Tailwind v4 + shadcn, shipped as static assets.",
  "license": "Apache-2.0",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle.git",
    "directory": "packages/mantle-admin-ui"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./index.html": "./dist/index.html",
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./kit.css": "./dist/kit.css",
    "./tokens.css": "./dist/tokens.css",
    "./registry/auth-page.json": "./dist/r/auth-page.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.kit.config.ts && tsc -p tsconfig.kit.json && shadcn build registry.json -o dist/r",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@aotter/mantle-admin": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "catalog:",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vitest": "catalog:"
  }
}
