{
  "name": "@aotter/mantle",
  "version": "0.1.0-alpha.8",
  "description": "Embeddable Mantle Core umbrella with Spec and Runtime; Web, Admin, Bun, Vercel, Cloudflare, and Admin UI are optional peer packages.",
  "license": "Apache-2.0",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle.git",
    "directory": "packages/mantle"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/spec.js",
  "types": "./dist/spec.d.ts",
  "bin": {
    "mantle": "./dist/cli/main.js",
    "mantle-harness": "./dist/cli/harness.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.js"
    },
    "./provision": {
      "types": "./dist/provision.d.ts",
      "import": "./dist/provision.js"
    },
    "./spec": {
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./runtime/testing": {
      "types": "./dist/runtime-testing.d.ts",
      "import": "./dist/runtime-testing.js"
    },
    "./codegen": {
      "types": "./dist/codegen.d.ts",
      "import": "./dist/codegen.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js"
    },
    "./vercel": {
      "types": "./dist/vercel.d.ts",
      "import": "./dist/vercel.js"
    },
    "./vercel/libsql": {
      "types": "./dist/vercel-libsql.d.ts",
      "import": "./dist/vercel-libsql.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "import": "./dist/cloudflare.js"
    },
    "./admin-ui": {
      "types": "./dist/admin-ui.d.ts",
      "import": "./dist/admin-ui.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "README.md"
  ],
  "dependencies": {
    "@aotter/mantle-runtime": "workspace:*",
    "@aotter/mantle-spec": "workspace:*"
  },
  "peerDependencies": {
    "@aotter/mantle-admin": "workspace:*",
    "@aotter/mantle-admin-ui": "workspace:*",
    "@aotter/mantle-bun": "workspace:*",
    "@aotter/mantle-cloudflare": "workspace:*",
    "@aotter/mantle-vercel": "workspace:*",
    "@aotter/mantle-web": "workspace:*",
    "@cloudflare/workers-oauth-provider": "catalog:peer",
    "aws4fetch": "catalog:peer",
    "better-auth": "catalog:peer",
    "hono": "catalog:peer",
    "@libsql/client": "catalog:peer",
    "zod": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@aotter/mantle-admin": {
      "optional": true
    },
    "@aotter/mantle-admin-ui": {
      "optional": true
    },
    "@aotter/mantle-bun": {
      "optional": true
    },
    "@aotter/mantle-cloudflare": {
      "optional": true
    },
    "@aotter/mantle-vercel": {
      "optional": true
    },
    "@aotter/mantle-web": {
      "optional": true
    },
    "@cloudflare/workers-oauth-provider": {
      "optional": true
    },
    "aws4fetch": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist .tsbuildinfo",
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-package-docs.mjs .",
    "postpack": "node ../../scripts/sync-package-docs.mjs . --clean"
  },
  "devDependencies": {
    "@aotter/mantle-admin": "workspace:*",
    "@aotter/mantle-admin-ui": "workspace:*",
    "@aotter/mantle-bun": "workspace:*",
    "@aotter/mantle-cloudflare": "workspace:*",
    "@aotter/mantle-vercel": "workspace:*",
    "@aotter/mantle-web": "workspace:*",
    "@cloudflare/workers-oauth-provider": "catalog:",
    "@types/node": "catalog:",
    "aws4fetch": "catalog:",
    "better-auth": "catalog:",
    "hono": "catalog:",
    "@libsql/client": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
