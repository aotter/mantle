{
  "name": "@aotter/mantle",
  "version": "0.2.0-alpha.9",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "README.md"
  ],
  "bin": {
    "mantle": "./dist/infrastructure/cli.js"
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "jsonc-parser": "3.3.1",
    "@pgsql/types": "18.0.0",
    "libpg-query": "18.1.5",
    "pgsql-deparser": "18.3.8",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "exports": {
    ".": "./dist/infrastructure/generate.js",
    "./generate": "./dist/infrastructure/generate.js",
    "./contracts": "./dist/kernel/contracts.js",
    "./authorization": "./dist/kernel/authorization.js",
    "./translations": "./dist/kernel/translations.js",
    "./driver/transaction-context": "./dist/kernel/driver/transaction-context.js",
    "./scalars": "./dist/kernel/scalars.js",
    "./binds": "./dist/kernel/binds.js",
    "./testing": "./dist/testing/index.js",
    "./host-access": "./dist/kernel/host-access.js",
    "./host-caller": "./dist/kernel/host-caller.js",
    "./user-fields": "./dist/kernel/user-fields.js",
    "./sweep": "./dist/kernel/sweep.js",
    "./cron": "./dist/kernel/cron.js",
    "./store": "./dist/kernel/store.js",
    "./dialect/sqlite": "./dist/kernel/dialect/sqlite.js",
    "./dialect/postgres": "./dist/kernel/dialect/postgres.js",
    "./driver/bun-sqlite": "./dist/kernel/driver/bun-sqlite.js",
    "./driver/d1": "./dist/kernel/driver/d1.js",
    "./driver/postgres": "./dist/kernel/driver/postgres.js",
    "./email": "./dist/kernel/email.js",
    "./paging": "./dist/kernel/paging.js",
    "./publishing": "./dist/kernel/publishing.js",
    "./rest": "./dist/kernel/rest.js",
    "./mcp": "./dist/kernel/mcp.js",
    "./mcp-apps": "./dist/kernel/mcp-apps.js",
    "./web": "./dist/kernel/web.js",
    "./validation": "./dist/kernel/validation.js",
    "./site": "./dist/kernel/site.js",
    "./media": "./dist/kernel/media.js",
    "./media/r2": "./dist/kernel/r2-media.js",
    "./auth": "./dist/auth/caller.js",
    "./auth/adapter": "./dist/auth/adapter.js",
    "./auth/oauth": "./dist/auth/oauth.js",
    "./auth/routes": "./dist/auth/routes.js",
    "./auth/identity": "./dist/auth/identity.js",
    "./auth/hardening": "./dist/auth/hardening.js",
    "./auth/admin": "./dist/auth/admin.js",
    "./bun/assets": "./dist/bun/assets.js",
    "./surface": "./dist/kernel/surface.js",
    "./json-body": "./dist/kernel/json-body.js",
    "./generate/auth": "./dist/infrastructure/generateAuth.js",
    "./package.json": "./package.json",
    "./describe": "./dist/domain/describe/index.js",
    "./target-hash": "./dist/domain/describe/target-hash.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.lib.json && node scripts/bundle-compiler.mjs && node scripts/prune-declarations.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/*.test.ts && bun run test:compiler",
    "generate": "bun src/infrastructure/cli.ts",
    "test:native": "bun scripts/verify-native.ts",
    "bench": "bun scripts/verify-native.ts --bench",
    "check:size": "bun run build && bun scripts/check-size.ts",
    "check:package": "bun run build && bun scripts/check-package.ts",
    "test:compiler": "tsc --noEmit -p tsconfig.compiler.json && vitest run --config vitest.compiler.config.ts",
    "prepack": "node ../../scripts/sync-package-docs.mjs .",
    "postpack": "node ../../scripts/sync-package-docs.mjs . --clean",
    "check:startup": "bun scripts/check-size.ts --startup-only"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "@better-auth/core": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "better-auth": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "@better-auth/core": {
      "optional": true
    },
    "@better-auth/oauth-provider": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@better-auth/core": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@better-auth/test-utils": "1.7.7",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "bun-types": "1.4.2",
    "postgres": "3.4.9",
    "typescript": "catalog:",
    "wrangler": "4.145.0",
    "vitest": "catalog:"
  },
  "description": "Agent-native app SDK and backend compiler: YAML manifests to native SQL (SQLite, Cloudflare D1, PostgreSQL) and typed TypeScript; optional REST and MCP.",
  "keywords": [
    "mantle",
    "agent-native",
    "sdk",
    "backend",
    "yaml",
    "code-generation",
    "sql",
    "sqlite",
    "postgresql",
    "cloudflare-d1",
    "cloudflare-workers",
    "bun",
    "typescript",
    "mcp",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle.git",
    "directory": "packages/mantle"
  },
  "bugs": {
    "url": "https://github.com/aotter/mantle/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org"
  }
}
