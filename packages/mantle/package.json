{
  "name": "@aotter/mantle",
  "version": "0.2.0-alpha.5",
  "description": "Mantle: a manifest-driven service core. Store authored as SQL, surfaces as Fetch functions, and the mantle CLI.",
  "license": "Apache-2.0",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle.git",
    "directory": "packages/mantle"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "import": "./dist/spec/index.js"
    },
    "./d1": {
      "types": "./dist/d1/index.d.ts",
      "import": "./dist/d1/index.js"
    },
    "./d1/compile": {
      "types": "./dist/d1/compile/index.d.ts",
      "import": "./dist/d1/compile/index.js",
      "default": "./dist/d1/compile/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./postgres/compile": {
      "types": "./dist/postgres/compile/index.d.ts",
      "import": "./dist/postgres/compile/index.js",
      "default": "./dist/postgres/compile/index.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare/index.d.ts",
      "import": "./dist/cloudflare/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json",
    "./bun": {
      "types": "./dist/bun/index.d.ts",
      "import": "./dist/bun/index.js"
    }
  },
  "bin": {
    "mantle": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prebuild": "rm -rf dist .tsbuildinfo",
    "build": "tsc -b tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "node ../../scripts/sync-package-docs.mjs .",
    "postpack": "node ../../scripts/sync-package-docs.mjs . --clean",
    "test:bun": "bun test/bun/native.ts"
  },
  "dependencies": {
    "@pgsql/types": "18.0.0",
    "libpg-query": "18.1.5",
    "pgsql-deparser": "18.3.8",
    "yaml": "^2.9.0",
    "zod": "catalog:",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/core": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@better-auth/utils": "catalog:",
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "better-auth": "catalog:",
    "bun-types": "1.3.14",
    "pg": "8.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.137.0",
    "@types/semver": "^7.7.1"
  },
  "peerDependencies": {
    "@better-auth/cimd": "catalog:",
    "@better-auth/mcp": "catalog:",
    "@better-auth/oauth-provider": "catalog:",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/server": "2.1.0",
    "better-auth": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@better-auth/cimd": {
      "optional": true
    },
    "@better-auth/mcp": {
      "optional": true
    },
    "@better-auth/oauth-provider": {
      "optional": true
    },
    "@modelcontextprotocol/ext-apps": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
