{
  "name": "@aotter/mantle-ui",
  "version": "0.2.0-alpha.6",
  "description": "Pure shared UI: framework-free generic interaction controller, React components, UI kit and tokens. No SDK dependency or Admin/MCP App.",
  "license": "Apache-2.0",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle.git",
    "directory": "packages/mantle-ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./controller": {
      "types": "./dist/controller/index.d.ts",
      "import": "./dist/controller/index.js"
    },
    "./kit": {
      "types": "./dist/kit/index.d.ts",
      "import": "./dist/kit/index.js"
    },
    "./kit.css": "./dist/kit/kit.css",
    "./tokens.css": "./dist/kit/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist .tsbuildinfo",
    "build": "tsc -b tsconfig.lib.json && vite build --config vite.kit.config.ts && node scripts/emit-kit-styles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.config.json",
    "test": "vitest run",
    "check:size": "node ../../scripts/check-ui-size.mjs mantle-ui"
  },
  "peerDependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependenciesMeta": {
    "class-variance-authority": {
      "optional": true
    },
    "clsx": {
      "optional": true
    },
    "input-otp": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "catalog:"
  }
}
