{
  "name": "mantle-app",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "mantle generate cloudflare-d1 generated manifests/*.yaml --auth src/auth.ts --entry src/index.ts --admin",
    "types": "wrangler types --include-runtime=false",
    "db:init": "wrangler d1 execute DB --local --file generated/schema.sql",
    "db:seed": "wrangler d1 execute DB --local --file seed.sql",
    "build": "mantle bundle src/index.ts dist",
    "test": "node --test generated/admin-mcp-app.check.mjs",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "check": "mantle generate cloudflare-d1 generated manifests/*.yaml --auth src/auth.ts --entry src/index.ts --admin --check && wrangler types --include-runtime=false --check && tsc --noEmit",
    "smoke": "node smoke.mjs",
    "accept": "node accept.mjs"
  },
  "dependencies": {
    "@aotter/mantle": "0.2.1-alpha.2",
    "@aotter/mantle-ui": "0.2.1-alpha.2",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@better-auth/utils": "0.4.2",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/server": "2.3.1",
    "better-auth": "1.7.7",
    "@aotter/mantle-admin": "0.2.1-alpha.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "playwright-core": "1.62.1",
    "typescript": "^6.0.3",
    "wrangler": "4.153.0"
  },
  "engines": {
    "node": ">=22.22"
  }
}
