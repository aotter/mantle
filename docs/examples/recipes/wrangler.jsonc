{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mantle-app",
  "main": "dist/worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "PUBLIC_ORIGIN",
      "ADMIN_EMAIL"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mantle-app"
    }
  ],
  // Recipe cover images (docs/handbook/cloudflare/media-r2.md). AGENT: create the bucket, serve its `committed/` prefix
  // on a public domain, and set MEDIA_PUBLIC_BASE / MEDIA_S3_ENDPOINT below to that domain and the bucket's S3 endpoint.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mantle-app-media"
    }
  ],
  "vars": {
    "MEDIA_PUBLIC_BASE": "https://media.example.com",
    "MEDIA_S3_ENDPOINT": "https://mantle-app-media.ACCOUNT_ID.r2.cloudflarestorage.com"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "triggers": {
    "crons": []
  },
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "dist/worker",
  "build": {
    "command": "mantle bundle src/index.ts dist",
    "watch_dir": [
      "src",
      "generated"
    ]
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js"
      ],
      "fallthrough": true
    }
  ]
}
