{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mantle-reference",
  "main": "dist/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mantle-reference"
    }
  ],
  "assets": {
    "directory": "node_modules/@aotter/mantle-admin/dist/admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "triggers": {
    "crons": [
      "0 3 * * 1"
    ]
  },
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "dist",
  "build": {
    "command": "mantle bundle src/index.ts dist",
    "watch_dir": [
      "src",
      "generated"
    ]
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js"
      ],
      "fallthrough": true
    }
  ]
}
