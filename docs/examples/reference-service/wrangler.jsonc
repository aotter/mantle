{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mantle-reference",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mantle-reference"
    }
  ],
  "assets": {
    "directory": "node_modules/@aotter/mantle-ui/dist/admin",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "triggers": {
    "crons": [
      "0 3 * * 1"
    ]
  }
}
