{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mantle-app",
  "main": "dist/worker/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "EMPLOYEE_DOMAIN": "example.com"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "PUBLIC_ORIGIN",
      "ADMIN_EMAIL",
      "SUPPLIER_API_URL",
      "SUPPLIER_WEBHOOK_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mantle-app"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "triggers": {
    "crons": [
      "0 9 * * *"
    ]
  },
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "dist/worker",
  "build": {
    "command": "mantle bundle src/index.ts dist",
    "watch_dir": [
      "src",
      "generated"
    ]
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js"
      ],
      "fallthrough": true
    }
  ]
}
