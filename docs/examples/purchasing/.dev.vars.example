# Copy to .dev.vars for local sign-in: one-time codes are printed to the wrangler log. Never deploy these values.
PUBLIC_ORIGIN=http://127.0.0.1:8787
ADMIN_EMAIL=you@example.com
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
SUPPLIER_API_URL=http://127.0.0.1:9999/orders
SUPPLIER_WEBHOOK_SECRET=replace-with-the-secret-the-supplier-signs-with
