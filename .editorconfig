root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

# Byte-exact vendored bundle (see its VENDORED.json); editors must not reformat it.
[plugins/mantle-host/skills/mantle-host/scripts/mantle-host.mjs]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
