{
  "name": "mantle-monorepo",
  "private": true,
  "version": "0.2.0-alpha.11",
  "description": "Mantle monorepo: agent-native application SDK that compiles YAML manifests to native SQL and typed TypeScript.",
  "license": "Apache-2.0",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle.git"
  },
  "bugs": {
    "url": "https://github.com/aotter/mantle/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter '@aotter/mantle*' build",
    "typecheck": "pnpm -r --filter '@aotter/mantle*' typecheck",
    "test": "pnpm -r --parallel --filter '@aotter/mantle*' test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:doc-examples": "node scripts/check-doc-examples.mjs",
    "check:plugin-manifests": "node scripts/sync-plugin-manifests.mjs --check",
    "check:release": "node scripts/release-tag-order.mjs --self-test",
    "check": "pnpm run check:boundaries && pnpm run check:skills && pnpm run check:plugin-manifests && pnpm run check:release && pnpm build && pnpm --filter @aotter/mantle exec bun scripts/check-size.ts && pnpm --filter @aotter/mantle exec bun scripts/check-package.ts && pnpm check:ui-size && pnpm check:doc-examples && pnpm check:oss-plugin && pnpm typecheck && MANTLE_NATIVE_TESTS=1 pnpm test && pnpm check:worker-consumer",
    "check:worker-consumer": "node scripts/check-worker-consumer.mjs",
    "bench": "pnpm --filter @aotter/mantle bench",
    "bench:cold": "pnpm --filter @aotter/mantle bench:cold",
    "bench:warm": "pnpm --filter @aotter/mantle bench:warm",
    "bench:check": "pnpm --filter @aotter/mantle bench:check",
    "bench:compare": "pnpm --filter @aotter/mantle bench:compare",
    "check:ui-size": "node scripts/check-ui-size.mjs",
    "check:startup": "pnpm --filter @aotter/mantle check:startup && node scripts/check-ui-size.mjs --startup-only",
    "check:oss-plugin": "node scripts/check-oss-plugin.mjs",
    "check:examples": "node scripts/check-examples.mjs"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "miniflare>sharp": "0.35.4",
      "@better-auth/mcp>@better-auth/oauth-provider": "1.7.7"
    }
  }
}
