{
  "name": "mantle-monorepo",
  "private": true,
  "version": "0.2.0-alpha.2",
  "description": "Embeddable, manifest-driven application runtime.",
  "license": "Apache-2.0",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter '@aotter/mantle*' build",
    "typecheck": "pnpm -r --filter '@aotter/mantle*' typecheck",
    "test": "pnpm -r --filter '@aotter/mantle*' test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:doc-examples": "node scripts/check-doc-examples.mjs",
    "check:plugin-manifests": "node scripts/sync-plugin-manifests.mjs --check",
    "check:release": "node scripts/release-tag-order.mjs --self-test",
    "check": "pnpm run check:boundaries && pnpm run check:skills && pnpm run check:plugin-manifests && pnpm run check:release && pnpm build && pnpm check:doc-examples && pnpm typecheck && pnpm test && pnpm check:worker-consumer",
    "check:worker-consumer": "node scripts/check-worker-consumer.mjs"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "miniflare>sharp": "0.35.4",
      "@better-auth/mcp>@better-auth/oauth-provider": "1.7.2"
    }
  }
}
