{
  "name": "mantle-monorepo",
  "private": true,
  "version": "0.1.0-alpha.7",
  "description": "Embeddable, manifest-driven application runtime.",
  "license": "Apache-2.0",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter '@aotter/mantle*' build",
    "typecheck": "pnpm -r --filter '@aotter/mantle*' typecheck",
    "test": "pnpm -r --filter '@aotter/mantle*' test",
    "bench:wrangler": "pnpm --filter @aotter/mantle-cloudflare bench:wrangler",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "check:optional-packages": "node scripts/check-optional-packages.mjs",
    "check:bun-package": "node scripts/check-bun-package.mjs",
    "check:vercel-package": "pnpm --dir packages/adapters/vercel/test/fixtures/live-node typecheck && node scripts/check-vercel-package.mjs",
    "check:release": "node scripts/release-tag-order.mjs --self-test",
    "check": "pnpm run check:boundaries && pnpm run check:skills && pnpm run check:release && pnpm build && pnpm run check:optional-packages && pnpm run check:bun-package && pnpm run check:vercel-package && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.15.0"
}
